# Copy to .env and fill in values: cp .env.example .env

# LLM — TokenRouter direct API (OpenAI-compatible), model z-ai/glm-5.3-free
TOKENROUTER_API_KEY=
TOKENROUTER_BASE_URL=https://api.tokenrouter.com/v1
TOKENROUTER_MODEL=z-ai/glm-5.3-free

